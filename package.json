{
	"name": "openaudit",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.18.0",
			"@orpc/server": "^1.15.0",
			"@orpc/openapi": "^1.15.0",
			"@orpc/zod": "^1.15.0",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.3",
			"@orpc/client": "^1.15.0",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/",
		"check": "biome check --write .",
		"test": "turbo run test",
		"audit": "bun apps/cli/src/bin.ts",
		"release:check": "cd apps/cli && bun run release:check && bun run build"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@openaudit/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"engines": {
		"bun": ">=1.4"
	},
	"packageManager": "bun@1.4.2"
}
