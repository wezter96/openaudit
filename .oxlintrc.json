{
	"rules": {
		"no-control-regex": "off",
		"no-misleading-character-class": "off",
		"no-unused-vars": [
			"warn",
			{
				"ignoreRestSiblings": true,
				"varsIgnorePattern": "^_",
				"argsIgnorePattern": "^_"
			}
		],
		"jsx-a11y/no-noninteractive-tabindex": ["warn", { "tags": ["section"] }]
	}
}
