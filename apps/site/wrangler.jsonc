{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openaudit-site",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Every request passes the Worker first, so www can be redirected.
		"run_worker_first": true,
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "openaudit.se", "custom_domain": true },
		{ "pattern": "www.openaudit.se", "custom_domain": true }
	],
	"workers_dev": false,
	// Each branch push uploads a version with its own preview URL (site.yml).
	"preview_urls": true,
	// Anonymous page views (worker/visits.ts); read them with `bun run stats`.
	"analytics_engine_datasets": [
		{ "binding": "VISITS", "dataset": "openaudit_site_visits" }
	],
	// Verified badges (worker/badge/). Schema: worker/badge/schema.sql.
	// The scanner's bearer token is the Worker secret SCANNER_TOKEN.
	"d1_databases": [
		{
			"binding": "BADGES",
			"database_name": "openaudit-badges",
			"database_id": "3e75e25b-d0f0-4567-8b61-9a9c7048f7af"
		}
	],
	"r2_buckets": [
		{ "binding": "BADGE_REPORTS", "bucket_name": "openaudit-badge-reports" }
	],
	"observability": { "enabled": false }
}
