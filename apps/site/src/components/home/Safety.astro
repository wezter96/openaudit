---
import { u } from "../../lib/site";
import Icon from "../Icon.astro";
import "../../styles/split.css";

type Glyph = "folder" | "globe" | "robot" | "container" | "git";
const items: { glyph: Glyph; lead: string; body: string }[] = [
	{ glyph: "folder", lead: "Files", body: "Reads stay in the project. Symlinks out are never followed." },
	{ glyph: "globe", lead: "HTTP", body: "Your headers go only to the target. Redirects drop credentials." },
	{ glyph: "robot", lead: "Agents", body: "Its own agents get no shell. The browser stays on the target." },
	{ glyph: "container", lead: "Wrapped tools", body: "Nothing gets built or installed. Linters that run code are opt-in." },
	{ glyph: "git", lead: "Git", body: "Hooks and fsmonitor are off. Diffs compare commits." },
];
---

<section class="sheet" id="safety" aria-labelledby="safety-title">
	<div class="frame split">
		<div class="sheet-head single">
			<h2 id="safety-title" class="rise">Safe on hostile input</h2>
			<p class="rise">Every target is treated as hostile. Nothing it scans gets built or run.</p>
			<p class="rise more"><a href={u("/docs/safety/")}>Safety model</a></p>
		</div>
		<ul class="guards">
			{
				items.map((i) => (
					<li class="rise">
						<Icon name={i.glyph} class="g" />
						<div>
							<h3>{i.lead}</h3>
							<p>{i.body}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.sheet-head.single {
		position: sticky;
		top: calc(var(--head) + 2rem);
	}

	.more {
		font-weight: 600;
		font-size: 0.9375rem;
	}

	.guards {
		border-top: 1px solid var(--ink);
	}

	.guards li {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		gap: 1rem;
		padding: 1.15rem 0 1.25rem;
		border-bottom: 1px solid var(--hair);
	}

	.guards :global(.g) {
		width: 1.5rem;
		height: 1.5rem;
		margin-top: 0.15rem;
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.guards h3 {
		font-size: 1.125rem;
		font-weight: 680;
		letter-spacing: -0.02em;
	}

	.guards p {
		margin-top: 0.3rem;
		color: var(--graphite);
		font-size: 0.9375rem;
		text-wrap: pretty;
	}

	@media (max-width: 60rem) {
		.sheet-head.single {
			position: static;
		}
	}
</style>
