---
import { wrappedCount } from "../../lib/home";
import { auditors, CATEGORIES, self, u } from "../../lib/site";

const items = [
	{ n: auditors.length, label: "auditors", href: u("/auditors/") },
	{ n: wrappedCount, label: "free scanners", href: u("/auditors/#engine=external") },
	{ n: CATEGORIES.length, label: "audit areas", href: "#areas" },
];
---

<section class="proof sheet" aria-label="openaudit in numbers">
	<div class="frame">
		<ul class="strip">
			{
				items.map((it) => (
					<li class="rise">
						<a href={it.href}>
							<span class="n num" data-count-to={it.n}>
								{it.n}
							</span>
							<span class="l">{it.label}</span>
						</a>
					</li>
				))
			}
			{
				self.available && self.grade && (
					<li class="rise self">
						<a href={u("/report/")}>
							<span class="n num">
								<b class={`gm-${self.grade}`}>{self.grade}</b>
								<span data-count-to={self.score}>{self.score}</span>
							</span>
							<span class="l">its own score</span>
						</a>
					</li>
				)
			}
		</ul>
	</div>
</section>

<style>
	.proof {
		padding-block: 0 clamp(3rem, 2rem + 3vw, 5rem);
	}

	.proof::before {
		display: none;
	}

	.strip {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--hair);
	}

	.strip li + li {
		border-left: 1px solid var(--hair);
	}

	.strip a {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		height: 100%;
		padding: 1.25rem 1.1rem 1.35rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.25s;
	}

	.strip a:hover {
		background: color-mix(in srgb, var(--paper-2) 70%, transparent);
	}

	.strip a:focus-visible {
		outline-offset: -2px;
	}

	.n {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem);
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.n b {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: -0.06em;
	}

	.l {
		font-size: 0.875rem;
		color: var(--graphite);
		line-height: 1.3;
		transition: color 0.2s;
	}

	.strip a:hover .l {
		color: var(--accent);
	}

	@media (max-width: 60rem) {
		.strip {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.strip li:nth-child(4) {
			border-left: 0;
		}

		.strip li:nth-child(n + 4) {
			border-top: 1px solid var(--hair);
		}
	}

	@media (max-width: 30rem) {
		.strip {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.strip li:nth-child(4) {
			border-left: 1px solid var(--hair);
		}

		.strip li:nth-child(odd) {
			border-left: 0;
		}

		.strip li:nth-child(n + 3) {
			border-top: 1px solid var(--hair);
		}
	}
</style>
