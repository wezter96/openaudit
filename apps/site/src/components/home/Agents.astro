---
import { BLOB, playbooks, u } from "../../lib/site";
import Command from "../Command.astro";
import Session from "../Session.astro";

const points = [
	{
		title: "MCP server",
		text: "For Claude Code, Cursor, Codex and more. Over stdio or HTTP.",
	},
	{
		title: `${playbooks.length} playbooks`,
		text: "For checks that need judgment. Your agent runs them, no extra API key.",
	},
	{
		title: "JSON mode",
		text: "<code>--json</code> prints one report and nothing else.",
	},
	{
		title: "Agent skill",
		text: `<a href="${BLOB}/skills/openaudit/SKILL.md"><code>SKILL.md</code></a> teaches the audit, fix, verify loop.`,
	},
];
---

<section class="sheet" id="agents" aria-labelledby="agents-title">
	<div class="frame agents">
		<div class="agents-copy">
			<div class="sheet-head single">
				<h2 id="agents-title" class="rise">Built for agents</h2>
				<p class="rise">Your agent runs the audit, fixes what it finds and checks the fix.</p>
			</div>
			<ul class="pts">
				{
					points.map((p) => (
						<li class="rise">
							<h3>{p.title}</h3>
							<p set:html={p.text} />
						</li>
					))
				}
			</ul>
			<div class="add rise">
				<Command command="claude mcp add openaudit -- bunx @openaudit/cli mcp" label="Copy the Claude Code setup command" />
				<a href={u("/docs/agents/")}>Agent setup</a>
			</div>
		</div>
		<Session />
	</div>
</section>

<style>
	.agents {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
		gap: 3rem clamp(2rem, 5vw, 5rem);
		align-items: start;
	}

	.sheet-head.single {
		grid-template-columns: 1fr;
		margin-bottom: 2rem;
	}

	.pts {
		border-top: 1px solid var(--hair);
	}

	.pts li {
		padding: 1rem 0 1.1rem;
		border-bottom: 1px solid var(--hair);
	}

	.pts h3 {
		font-size: 1.125rem;
		font-weight: 680;
		letter-spacing: -0.02em;
	}

	.pts p :global(code) {
		font-size: 0.85em;
		padding: 0.05em 0.3em;
		border-radius: 4px;
		background: var(--paper-3);
	}

	.pts p {
		margin-top: 0.3rem;
		color: var(--graphite);
		font-size: 0.9375rem;
		text-wrap: pretty;
	}

	.add {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
		margin-top: 1.75rem;
	}

	.add :global(.cmd) {
		max-width: 100%;
	}

	.add :global(.cmd code) {
		font-size: 0.875rem;
	}

	.add a {
		font-weight: 600;
		font-size: 0.9375rem;
	}

	@media (max-width: 60rem) {
		.agents {
			grid-template-columns: minmax(0, 1fr);
		}

		.agents :global(.session) {
			position: static;
		}
	}
</style>
