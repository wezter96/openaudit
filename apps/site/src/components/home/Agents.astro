---
import { BLOB, playbooks, u } from "../../lib/site";
import Command from "../Command.astro";

const points = [
	{
		title: "MCP server",
		text: "For Claude Code, Cursor, Codex and more. Over stdio or HTTP.",
	},
	{
		title: `${playbooks.length} playbooks`,
		text: "For checks that need judgment. Your agent runs them, no extra API key.",
	},
	{
		title: "JSON mode",
		text: "<code>--json</code> prints one report and nothing else.",
	},
	{
		title: "Agent skill",
		text: `<a href="${BLOB}/skills/openaudit/SKILL.md"><code>SKILL.md</code></a> teaches the audit, fix, verify loop.`,
	},
];
---

<section class="sheet" id="agents" aria-labelledby="agents-title">
	<div class="frame agents">
		<div class="agents-copy">
			<div class="sheet-head single">
				<h2 id="agents-title" class="rise">Built for agents</h2>
				<p class="rise">Your agent runs the audit, fixes what it finds and checks the fix.</p>
			</div>
			<ul class="pts">
				{
					points.map((p) => (
						<li class="rise">
							<h3>{p.title}</h3>
							<p set:html={p.text} />
						</li>
					))
				}
			</ul>
			<div class="add rise">
				<Command command="claude mcp add openaudit -- bunx @openaudit/cli mcp" label="Copy the Claude Code setup command" />
				<a href={u("/docs/agents/")}>Agent setup</a>
			</div>
		</div>
		<figure class="session" data-session>
			<figcaption>Example session in Claude Code</figcaption>
			<div class="screen">
				<ol class="log">
					<li class="you">Audit this repo and fix what matters.</li>
					<li class="call"><b>openaudit</b> run_audit <span>target: "."</span></li>
					<li class="out">78/100, grade C. 1 critical and 3 high findings from 41 auditors.</li>
					<li class="call"><b>openaudit</b> get_playbook <span>id: "agent.authz"</span></li>
					<li class="out">Authentication and authorization review: inventory every route, then check who can reach it.</li>
					<li class="tool">Read src/routes/admin.ts</li>
					<li class="call"><b>openaudit</b> submit_findings <span>2 findings</span></li>
					<li class="out">Merged into the report. Security 61 to 54.</li>
					<li class="tool">Edit src/routes/admin.ts, src/config.ts</li>
					<li class="call"><b>openaudit</b> compare_reports</li>
					<li class="out good">3 fixed, 0 new.</li>
				</ol>
			</div>
		</figure>
	</div>
</section>

<script>
	import "../../scripts/session";
</script>

<style>
	.agents {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
		gap: 3rem clamp(2rem, 5vw, 5rem);
		align-items: start;
	}

	.sheet-head.single {
		grid-template-columns: 1fr;
		margin-bottom: 2rem;
	}

	.pts {
		border-top: 1px solid var(--hair);
	}

	.pts li {
		padding: 1rem 0 1.1rem;
		border-bottom: 1px solid var(--hair);
	}

	.pts h3 {
		font-size: 1.125rem;
		font-weight: 680;
		letter-spacing: -0.02em;
	}

	.pts p :global(code) {
		font-size: 0.85em;
		padding: 0.05em 0.3em;
		border-radius: 4px;
		background: var(--paper-3);
	}

	.pts p {
		margin-top: 0.3rem;
		color: var(--graphite);
		font-size: 0.9375rem;
		text-wrap: pretty;
	}

	.add {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
		margin-top: 1.75rem;
	}

	.add :global(.cmd) {
		max-width: 100%;
	}

	.add :global(.cmd code) {
		font-size: 0.875rem;
	}

	.add a {
		font-weight: 600;
		font-size: 0.9375rem;
	}

	.session {
		position: sticky;
		top: calc(var(--head) + 2rem);
		margin: 0;
		padding: 1.1rem 1.25rem 1.3rem;
		border-radius: 12px;
		background: #0d1522;
		color: #d8e0eb;
		box-shadow: var(--shot);
		font-family: var(--mono);
		font-size: 0.8125rem;
		line-height: 1.55;
	}

	:global(:root[data-theme="dark"]) .session {
		background: #060a11;
		box-shadow: 0 0 0 1px var(--hair);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme="light"])) .session {
			background: #060a11;
			box-shadow: 0 0 0 1px var(--hair);
		}
	}

	.session figcaption {
		font-family: var(--sans);
		font-size: 0.75rem;
		color: #9aa7b9;
		padding-bottom: 0.8rem;
		margin-bottom: 0.9rem;
		border-bottom: 1px solid #2a374c;
	}

	.log li + li {
		margin-top: 0.45rem;
	}

	.log .you {
		color: #fff;
		font-family: var(--sans);
		font-size: 0.9375rem;
		padding-bottom: 0.5rem;
	}

	.log .you::before {
		content: "> ";
		color: #8fa2ff;
		font-family: var(--mono);
	}

	.log .call::before,
	.log .tool::before {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.6rem;
		border-radius: 50%;
		background: #8fa2ff;
		vertical-align: 0.05em;
	}

	.log .tool {
		color: #9aa7b9;
	}

	.log .tool::before {
		background: #4a5668;
	}

	.log .call b {
		color: #fff;
		font-weight: 600;
	}

	.log .call span {
		color: #9aa7b9;
	}

	.log .out {
		padding-left: 1.1rem;
		color: #b9c4d3;
		border-left: 1px solid #2a374c;
		margin-left: 0.22rem;
	}

	.log .good {
		color: #4fd49b;
	}

	/* with motion, the session plays in a window of a few lines, like a
	   terminal, instead of standing at full height */
	.session:global(.play) .screen {
		position: relative;
		height: 8.75rem;
		overflow: hidden;
		mask-image: linear-gradient(to bottom, transparent, #000 2rem);
	}

	.session:global(.play) .log {
		position: relative;
		transition: transform 0.7s var(--settle);
	}

	.session:global(.play) .log li {
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.4s var(--soft),
			transform 0.6s var(--soft);
	}

	.session:global(.play) .log li:global(.on) {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 60rem) {
		.agents {
			grid-template-columns: minmax(0, 1fr);
		}

		.session {
			position: static;
		}
	}
</style>
