---
import scoring from "../../generated/scoring.json";
import { wrappedCount } from "../../lib/home";
import { HANDOFF_AGENTS, u } from "../../lib/site";
import "../../styles/split.css";

const ex = (sev: string) => scoring.examples.find((e) => e.severity === sev && e.n === 1)?.score;

const minA = scoring.bands.find((b) => b.grade === "A")?.min ?? 90;
const faqs = [
	{
		q: "Do I need to know how to code?",
		a: `No. Your AI runs it, reads the results and makes the fixes. You can open the report yourself too: every finding says what's wrong and how to fix it, in plain words. Works in ${HANDOFF_AGENTS}.`,
	},
	{
		q: "Does it upload my code?",
		a: "No. It runs on your machine. Dependency checks ask OSV.dev and URL audits call the site you name. <code>--offline</code> stops the rest. Code only leaves if you turn on the agentic auditors.",
	},
	{
		q: "What does the grade mean?",
		a: `Each area gets a score from 0 to 100, and every problem costs points by how serious it is. ${minA} or more is an A. One critical problem takes an area to ${ex("critical")}. <a href="${u("/docs/report/#scoring")}">How scoring works</a>`,
	},
	{
		q: "What do I need installed?",
		a: `Just <a href="https://bun.sh">Bun</a> 1.4+, and your AI can install that. The other ${wrappedCount} scanners are used when installed and skipped when not. The <a href="${u("/docs/ci/#docker")}">Docker image</a> has them all.`,
	},
	{
		q: "Is it free?",
		a: "Yes. MIT licence and free scanners. The AI features cost tokens, and they're opt-in.",
	},
];
---

<section class="sheet" id="faq" aria-labelledby="faq-title">
	<div class="frame split">
		<div class="sheet-head single">
			<h2 id="faq-title" class="rise">Questions</h2>
		</div>
		<div class="qs">
			{
				faqs.map((f) => (
					<details class="rise">
						<summary>
							<span>{f.q}</span>
							<svg class="plus" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path d="M5 12h14M12 5v14" />
							</svg>
						</summary>
						<p set:html={f.a} />
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.qs {
		border-top: 1px solid var(--ink);
	}

	details {
		border-bottom: 1px solid var(--hair);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 3.5rem;
		padding: 0.9rem 0;
		font-size: 1.125rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		cursor: pointer;
		list-style: none;
		transition: color 0.2s;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		color: var(--accent);
	}

	summary:focus-visible {
		outline-offset: 2px;
	}

	.plus {
		flex: none;
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		transition: transform 0.5s var(--settle);
	}

	details[open]:not(.closing) .plus {
		transform: rotate(45deg);
	}


	details p {
		padding: 0 2.5rem 1.25rem 0;
		color: var(--graphite);
		max-width: 44rem;
		text-wrap: pretty;
	}

	details p :global(code) {
		font-size: 0.85em;
		padding: 0.05em 0.3em;
		border-radius: 4px;
		background: var(--paper-3);
	}
</style>
