---
import { HANDOFF, HANDOFF_AGENTS } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
	/** Distinguishes the hint's id when the box appears twice on a page. */
	readonly id?: string;
}
const { id = "handoff" } = Astro.props;
---

<div class="handoff">
	<button
		class="btn primary run-ai needs-js"
		type="button"
		data-copy-text={HANDOFF}
		data-copied-label="Copied. Paste it into your AI"
		aria-describedby={`${id}-hint`}
	>
		<Icon name="robot" class="idle" />
		<Icon name="check" class="done" />
		<span class="copy-label">Run it with your AI</span>
	</button>
	<p class="handoff-hint" id={`${id}-hint`}>Copies a one-line prompt for {HANDOFF_AGENTS}.</p>
	<details class="peek">
		<summary>What gets copied?</summary>
		<p>{HANDOFF}</p>
	</details>
</div>

<style>
	.handoff {
		max-width: 34rem;
	}

	.run-ai {
		min-height: 3.25rem;
		padding-inline: 1.4rem;
		font-size: 1.0625rem;
	}

	.run-ai :global(.done) {
		display: none;
	}

	.run-ai:global(.copied) :global(.idle) {
		display: none;
	}

	.run-ai:global(.copied) :global(.done) {
		display: block;
	}

	.handoff-hint {
		margin-top: 0.6rem;
		font-size: 0.875rem;
		color: var(--graphite);
	}

	.peek {
		margin-top: 0.35rem;
		font-size: 0.875rem;
		color: var(--graphite);
	}

	.peek summary {
		cursor: pointer;
		width: fit-content;
		text-decoration: underline;
		text-decoration-color: var(--hair);
		text-underline-offset: 0.2em;
	}

	.peek summary:hover {
		color: var(--accent);
	}

	.peek p {
		margin-top: 0.5rem;
		padding: 0.6rem 0.8rem;
		border-left: 2px solid var(--accent);
		background: var(--paper-2);
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	/* without script the button can't copy, so the sentence shows instead */
	:global(html:not(.js)) .peek summary {
		display: none;
	}
</style>
