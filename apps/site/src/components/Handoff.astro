---
import { HANDOFF, HANDOFF_AGENTS } from "../lib/site";
import Icon from "./Icon.astro";
---

<figure class="handoff">
	<figcaption>Paste this into your AI</figcaption>
	<div class="handoff-box">
		<p>{HANDOFF}</p>
		<button class="copy-btn needs-js" type="button" data-copy-text={HANDOFF} aria-label="Copy the sentence for your AI">
			<Icon name="copy" class="idle" />
			<Icon name="check" class="done" />
			<span class="copy-label">Copy</span>
		</button>
	</div>
	<p class="handoff-hint">Works in {HANDOFF_AGENTS}: any agent that can run commands.</p>
</figure>

<style>
	.handoff {
		margin: 0;
		max-width: 34rem;
	}

	figcaption {
		font-size: 0.8125rem;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.handoff-box {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		margin-top: 0.6rem;
		padding: 0.9rem 0.75rem 0.9rem 1.1rem;
		background: var(--paper-2);
		border: 1px solid var(--hair);
		border-left: 3px solid var(--accent);
		border-radius: 10px;
		box-shadow: var(--lift);
	}

	.handoff-box p {
		flex: 1;
		min-width: 0;
		font-size: 1.0625rem;
		font-weight: 550;
		line-height: 1.45;
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	.handoff-hint {
		margin-top: 0.6rem;
		font-size: 0.875rem;
		color: var(--graphite);
	}
</style>
