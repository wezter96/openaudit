---
import Docs from "../../layouts/Docs.astro";
import { introParagraphsIn, readRepo, render } from "../../lib/markdown";

const FILE = "CONTRIBUTING.md";
const source = readRepo(FILE);
const [lede = "", ...intro] = introParagraphsIn(FILE);
const body = source.slice(source.indexOf("\n## ")).trim();
---

<Docs
	slug="contributing"
	lede={render(lede, FILE).replace(/^<p>|<\/p>\s*$/g, "")}
	sources={[FILE, "AGENTS.md", "CODE_OF_CONDUCT.md"]}
>
	<Fragment set:html={render(intro.join("\n\n"), FILE)} />
	<Fragment set:html={render(body, FILE)} />
</Docs>
