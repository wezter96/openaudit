---
import Docs from "../../layouts/Docs.astro";
import { API_RUN, apiInfo, apiOperations, apiServer } from "../../lib/docs";
import { inline, render } from "../../lib/markdown";
import { u } from "../../lib/site";
---

<Docs slug="api" lede={inline(apiInfo.description)} sources={["apps/server/src/index.ts", "packages/api/src/routers/index.ts", "packages/api/src/openapi.ts"]}>
	<h2 id="run-it">Run it</h2>
	<Fragment set:html={render(API_RUN, "README.md")} />
	<h2 id="endpoints">Endpoints</h2>
	<p>Paths are relative to <code>{apiServer.url}</code>. Generated from the router's OpenAPI document when the site is built.</p>
	<div class="table">
		<table>
			<thead><tr><th scope="col">Endpoint</th><th scope="col">Description</th></tr></thead>
			<tbody>
				{
					apiOperations.map((o) => (
						<tr>
							<th scope="row"><code>{o.method} {o.path}</code></th>
							<td>
								{o.summary && <b>{o.summary}.</b>} {o.description}
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<h2 id="openapi">OpenAPI</h2>
	<p>
		The OpenAPI 3.1 document is published at <a href={u("/openapi.json")}>/openapi.json</a> for discovery. A running server serves the same document at <code>/api-reference/spec.json</code> and an interactive reference at <code>/api-reference</code>.
	</p>
</Docs>
