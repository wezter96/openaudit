---
import Docs from "../../layouts/Docs.astro";
import { agentSettings, configSchema, configSchemaUrl, configRows as rows } from "../../lib/docs";
import { inline, paragraphsIn, readRepo, render, section } from "../../lib/markdown";
import { u } from "../../lib/site";

const CLI = "apps/cli/README.md";
const lede = paragraphsIn("README.md", "Configuration")[0] ?? "";
const trust = paragraphsIn("README.md", "Configuration")[1] ?? "";
const settingsCode = agentSettings.code;
---

<Docs
	slug="configuration"
	lede={inline(lede)}
	sources={["README.md", CLI, "apps/cli/src/config.ts"]}
>
	<p set:html={inline(trust)} />
	<h2 id="the-config-file">The config file</h2>
	<Fragment set:html={render(section(readRepo(CLI), "Configuration", { body: true }), CLI)} />
	<h2 id="reference">Reference</h2>
	<p>
		Generated from <code>openaudit schema config</code>. Keys marked <em>trusted only</em> are ignored with a warning when the config is found inside the audited target; pass the file with <code>--config &lt;path&gt;</code> to use them.
	</p>
	<div class="table">
		<table>
			<thead>
				<tr><th scope="col">Key</th><th scope="col">Type</th><th scope="col">Default</th><th scope="col">Notes</th></tr>
			</thead>
			<tbody>
				{
					rows.map((r) => (
						<tr>
							<th scope="row"><code>{r.key}</code></th>
							<td><code class="type">{r.type}</code></td>
							<td>{r.def ? <code>{r.def}</code> : <span class="muted">none</span>}</td>
							<td>
								{r.trusted && <span class="badge">Trusted only</span>}
								{r.note && <span set:html={inline(r.note)} />}
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<h2 id="per-auditor-settings">Per-auditor settings</h2>
	<p>Settings for the agentic auditors go in <code>options.settings</code>, under <code>"agent"</code> for all of them or under one auditor's id.</p>
	{settingsCode && <Fragment set:html={render(`\`\`\`${settingsCode.lang ?? ""}\n${settingsCode.text}\n\`\`\``, agentSettings.file)} />}
	<p set:html={inline(agentSettings.text, agentSettings.file)} />
	<h2 id="json-schema">JSON Schema</h2>
	<p>
		Published at <code>{configSchemaUrl}</code> (<a href={u("/schema/config.json")}>this site's copy</a>). <code>openaudit init</code> sets it as <code>$schema</code>, so editors complete keys, show these notes on hover and flag mistakes. Offline, <code>openaudit schema config</code> prints the same schema.
	</p>
	<details>
		<summary>Show the schema</summary>
		<pre>{JSON.stringify(configSchema, null, 2)}</pre>
	</details>
</Docs>

<style>
	.badge {
		display: inline-block;
		margin-right: 0.5rem;
		padding: 0 0.4rem;
		border: 1px solid var(--t-medium);
		border-radius: 4px;
		color: var(--t-medium);
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.type {
		white-space: normal;
	}
</style>
