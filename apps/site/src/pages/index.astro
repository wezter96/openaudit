---
import Command from "../components/Command.astro";
import Agents from "../components/home/Agents.astro";
import Areas from "../components/home/Areas.astro";
import Coverage from "../components/home/Coverage.astro";
import Faq from "../components/home/Faq.astro";
import Flow from "../components/home/Flow.astro";
import Hero from "../components/home/Hero.astro";
import Open from "../components/home/Open.astro";
import Proof from "../components/home/Proof.astro";
import Safety from "../components/home/Safety.astro";
import Showcase from "../components/home/Showcase.astro";
import Icon from "../components/Icon.astro";
import Integrations from "../components/Integrations.astro";
import Base from "../layouts/Base.astro";
import { wrappedCount } from "../lib/home";
import { counts, PITCH, REPO, SITE, u } from "../lib/site";

const description = `${counts.builtin} built-in auditors and ${wrappedCount} free scanners, merged into one report with a 0–100 score and an A–F grade in each of ten areas.`;
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "openaudit",
	url: `${SITE}${u("/")}`,
	description: PITCH,
	applicationCategory: "DeveloperApplication",
	operatingSystem: "Any system that runs Bun 1.4 or newer",
	license: "https://opensource.org/licenses/MIT",
	isAccessibleForFree: true,
	offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
	sameAs: [REPO],
}).replace(/</g, "\\u003c");
---

<Base title={PITCH} ogTitle={PITCH} description={description} heroDial>
	<script type="application/ld+json" slot="head" is:inline set:html={jsonLd} />
	<Hero />
	<Proof />
	<Areas />
	<Coverage />
	<Flow />
	<Showcase />
	<Agents />
	<section class="sheet" id="integrations" aria-labelledby="integrations-title">
		<div class="frame">
			<div class="sheet-head">
				<h2 id="integrations-title" class="rise">Runs where you already work</h2>
				<p class="rise">Same report from every route.</p>
			</div>
			<Integrations />
		</div>
	</section>
	<Safety />
	<Open />
	<Faq />
	<section class="sheet closing" aria-labelledby="try-title">
		<div class="frame">
			<h2 id="try-title" class="rise">Audit your own project</h2>
			<div class="rise"><Command command="bunx @openaudit/cli . -f html -o report" /></div>
			<p class="rise muted">Then open <code>report/openaudit-report.html</code>.</p>
			<div class="rise links">
				<a class="btn primary" href={u("/docs/")}>Read the docs</a>
				<a class="btn" href={u("/report/")}><Icon name="report" />See a live report</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.closing .frame {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}

	.closing h2 {
		font-family: var(--display);
		font-size: clamp(2.5rem, 1.4rem + 4vw, 4.5rem);
		font-weight: 780;
		letter-spacing: -0.05em;
		line-height: 0.95;
	}

	.closing .muted {
		max-width: 38rem;
		font-size: 0.9375rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
</style>
