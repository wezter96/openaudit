---
import Handoff from "../components/Handoff.astro";
import Faq from "../components/home/Faq.astro";
import Hero from "../components/home/Hero.astro";
import Problem from "../components/home/Problem.astro";
import Showcase from "../components/home/Showcase.astro";
import Steps from "../components/home/Steps.astro";
import Trust from "../components/home/Trust.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { wrappedCount } from "../lib/home";
import { counts, PITCH, REPO, SITE, u } from "../lib/site";

/** What people search for, so the title and description lead with it. */
const title = "open-source code and security audit for AI agents";
const description = `Free, open-source audit of code, sites, containers and cloud: ${counts.builtin} checks and ${wrappedCount} scanners in one report. Run it from CI or your AI agent over MCP.`;
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "openaudit",
	url: `${SITE}${u("/")}`,
	description,
	applicationCategory: "DeveloperApplication",
	operatingSystem: "Any system that runs Bun 1.4 or newer",
	license: "https://opensource.org/licenses/MIT",
	isAccessibleForFree: true,
	offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
	sameAs: [REPO],
}).replace(/</g, "\\u003c");
---

<Base title={title} ogTitle={PITCH} description={description} heroDial>
	<script type="application/ld+json" slot="head" is:inline set:html={jsonLd} />
	<Hero />
	<Problem />
	<Steps />
	<Showcase compact />
	<Trust />
	<Faq />
	<section class="sheet closing" aria-labelledby="try-title">
		<div class="frame">
			<h2 id="try-title" class="rise">Put it <span class="tone">to work</span></h2>
			<div class="rise"><Handoff /></div>
			<div class="rise links">
				<a class="btn primary" href={u("/report/")}><Icon name="report" />See a live report</a>
				<a class="btn" href={u("/developers/")}><Icon name="terminal" />For developers</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.closing .frame {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}

	.closing h2 {
		font-family: var(--display);
		font-size: clamp(2.5rem, 1.4rem + 4vw, 4.5rem);
		font-weight: 780;
		letter-spacing: -0.035em;
		line-height: 0.95;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
</style>
