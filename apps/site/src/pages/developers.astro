---
import Command from "../components/Command.astro";
import Agents from "../components/home/Agents.astro";
import Areas from "../components/home/Areas.astro";
import Coverage from "../components/home/Coverage.astro";
import Flow from "../components/home/Flow.astro";
import Safety from "../components/home/Safety.astro";
import Showcase from "../components/home/Showcase.astro";
import Icon from "../components/Icon.astro";
import Integrations from "../components/Integrations.astro";
import Base from "../layouts/Base.astro";
import { wrappedCount } from "../lib/home";
import { counts, DEVELOPERS_DESCRIPTION, REPO, u } from "../lib/site";
---

<Base title="openaudit for developers" description={DEVELOPERS_DESCRIPTION}>
	<header class="page-head frame">
		<h1>Everything under the hood</h1>
		<p class="lede">
			<span class="num">{counts.builtin}</span> built-in auditors and <span class="num">{wrappedCount}</span> wrapped scanners, merged into one scored report. Run it from your terminal, your CI or your agent.
		</p>
		<div class="head-cmd">
			<Command command="bunx @openaudit/cli ." />
			<div class="head-links">
				<a class="btn primary" href={u("/docs/")}>Read the docs</a>
				<a class="btn" href={REPO}><Icon name="github" />Source</a>
			</div>
		</div>
	</header>
	<Agents />
	<Areas />
	<Coverage open />
	<Flow />
	<Showcase />
	<section class="sheet" id="integrations" aria-labelledby="integrations-title">
		<div class="frame">
			<div class="sheet-head">
				<h2 id="integrations-title" class="rise">Runs where you already work</h2>
				<p class="rise">Same report from every route.</p>
			</div>
			<Integrations />
		</div>
	</section>
	<Safety open />
</Base>

<style>
	.head-cmd {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.75rem;
	}

	.head-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
</style>
