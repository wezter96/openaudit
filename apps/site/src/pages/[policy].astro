---
/** One policy from src/policies/*.md, at /<slug>/ (see src/lib/policies.ts). */
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import { render } from "../lib/markdown";
import { type Policy, policies } from "../lib/policies";

export const getStaticPaths = (() => policies.map((policy) => ({ params: { policy: policy.slug }, props: { policy } }))) satisfies GetStaticPaths;

const { policy } = Astro.props as { policy: Policy };
---

<Base title={policy.title} description={policy.description} ogTitle={policy.heading}>
	<article class="frame policy">
		<h1>{policy.heading}</h1>
		<div class="prose">
			<Fragment set:html={render(policy.body, policy.file)} />
		</div>
	</article>
</Base>

<style>
	.policy {
		max-width: 48rem;
		padding-block: clamp(2rem, 1rem + 4vw, 4rem) 2rem;
	}

	h1 {
		font-family: var(--display);
		font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
		font-weight: 780;
		letter-spacing: -0.04em;
		line-height: 1.02;
		text-wrap: balance;
		margin-bottom: 1.75rem;
	}
</style>
