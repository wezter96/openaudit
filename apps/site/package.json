{
	"name": "site",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare-data": "bun scripts/prepare.ts",
		"dev": "bun scripts/prepare.ts && astro dev",
		"build": "bun scripts/prepare.ts && astro build && bun scripts/postbuild.ts",
		"preview": "wrangler dev",
		"check-types": "bun scripts/prepare.ts --data-only && astro check",
		"test": "bun test worker",
		"check:ui": "bun scripts/check-ui.ts",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"astro": "7.3.8",
		"marked": "^18.1.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@expo-google-fonts/inter": "^0.4.2",
		"@expo-google-fonts/jetbrains-mono": "^0.4.1",
		"@resvg/resvg-js": "^2.6.2",
		"@types/bun": "catalog:",
		"playwright": "1.56.1",
		"typescript": "catalog:",
		"wrangler": "^4.150.0"
	}
}
