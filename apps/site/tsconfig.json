{
	"extends": "astro/tsconfigs/strictest",
	"include": [
		".astro/types.d.ts",
		"src",
		"scripts",
		"worker",
		"astro.config.ts"
	],
	"exclude": ["dist"],
	"compilerOptions": {
		"types": ["bun"],
		// The build imports the CLI and auditor sources, which follow the
		// repository's settings rather than this preset's.
		"exactOptionalPropertyTypes": false,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true
	}
}
