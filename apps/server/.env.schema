# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=url
CORS_ORIGIN=

# Let `audit.url` reach private, loopback and link-local addresses and any port.
# Only enable when self-hosting to audit your own internal services.
# @public @type=boolean
ALLOW_PRIVATE_TARGETS=false

# Behind a reverse proxy, take the client IP (for rate limiting) from the last
# X-Forwarded-For entry. Leave false when the server is exposed directly.
# @public @type=boolean
TRUST_PROXY=false
