{
  "openapi": "3.0.3",
  "info": { "title": "Orders", "version": "1.1.0" },
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "parameters": [
          { "name": "code", "in": "query", "schema": { "type": "string", "pattern": "^[a-z0-9]+$" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sku": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    }
  }
}
