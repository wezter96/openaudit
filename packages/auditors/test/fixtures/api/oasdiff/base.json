{
  "openapi": "3.0.3",
  "info": { "title": "Orders", "version": "1.0.0" },
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "parameters": [
          { "name": "X-Trace", "in": "header", "schema": { "type": "string" } },
          { "name": "code", "in": "query", "schema": { "type": "string", "pattern": "^[a-z]+$" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sku": { "type": "string" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    }
  }
}
