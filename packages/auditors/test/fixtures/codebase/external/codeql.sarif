                "region": { "startLine": 12, "startColumn": 5, "endColumn": 38 }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "3f2e1c0b9a8d7e6f:1",
            "primaryLocationStartColumnFingerprint": "0"
          },
          "codeFlows": [],
          "relatedLocations": [
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": { "uri": "src/client.js", "uriBaseId": "%SRCROOT%", "index": 0 },
                "region": { "startLine": 9, "startColumn": 15, "endColumn": 30 }
              },
              "message": { "text": "user-provided value" }
            }
          ]
        },
        {
          "ruleId": "js/insecure-randomness",
          "ruleIndex": 1,
          "rule": { "id": "js/insecure-randomness", "index": 1 },
          "message": {
            "text": "This uses a cryptographically insecure random number generated at [Math.random()](1) in a security context."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/util/token.js", "uriBaseId": "%SRCROOT%", "index": 1 },
                "region": { "startLine": 4, "startColumn": 18, "endColumn": 33 }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "a1b2c3d4e5f60718:1"
          }
