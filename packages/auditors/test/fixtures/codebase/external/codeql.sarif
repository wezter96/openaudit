            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/legacy.js", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "properties": {
        "semmle.formatSpecifier": "sarif-latest",
        "semmle.sourceLanguage": "javascript"
      }
    }
