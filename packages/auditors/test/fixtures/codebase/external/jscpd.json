      "fragment": "export function summarizeInvoice(lines: Array<{ sku: string; qty: number; price: number }>, taxRate: number) {\n\tlet subtotal = 0;\n\tconst seen = new Set<string>();\n\tfor (const line of lines) {\n\t\tif (line.qty <= 0) {\n\t\t\tcontinue;\n\t\t}\n\t\tif (seen.has(line.sku)) {\n\t\t\tthrow new Error(`duplicate sku ${line.sku}`);\n\t\t}\n\t\tseen.add(line.sku);\n\t\tsubtotal += line.qty * line.price;\n\t}\n\tconst tax = Math.round(subtotal * taxRate * 100) / 100;\n\treturn { subtotal, tax, total: subtotal + tax, items: seen.size };\n}",
