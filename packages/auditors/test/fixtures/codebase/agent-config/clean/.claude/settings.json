{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": ["Bash(bun test *)", "Bash(git status)", "WebFetch(domain:docs.example.com)", "Read"],
		"deny": ["Bash", "WebFetch", "Read(./.env)"],
		"defaultMode": "acceptEdits"
	},
	"hooks": {
		"Stop": [{ "hooks": [{ "type": "command", "command": "bun run check" }] }]
	}
}
