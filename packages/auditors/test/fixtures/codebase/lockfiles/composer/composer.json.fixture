{
    "name": "acme/app",
    "require": {
        "acme/lib": "dev-main",
        "acme/local": "*",
        "monolog/monolog": "^3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/acme/lib"
        },
        {
            "type": "composer",
            "url": "http://packages.example.com"
        },
        {
            "type": "path",
            "url": "../../outside/local"
        }
    ],
    "config": {
        "secure-http": false
    }
}
